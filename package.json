{
	"name": "astra-checkers",
	"version": "2.0.0",
	"private": true,
	"description": "A complete, accessible, offline checkers club for GitHub Pages.",
	"type": "module",
	"scripts": {
		"start": "vite --host 127.0.0.1",
		"dev": "vite --host 127.0.0.1",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src tests scripts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"benchmark": "tsx scripts/benchmark.ts",
		"generate:knowledge": "tsx scripts/generate-knowledge.ts",
		"check:size": "node scripts/check-size.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.2",
		"@biomejs/biome": "^2.2.0",
		"@playwright/test": "^1.55.0",
		"@types/node": "^24.0.0",
		"fake-indexeddb": "^6.2.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"vite": "^7.1.0",
		"vitest": "^3.2.0"
	}
}
